TARGETNAME=InterruptLatencyMonitor
TARGETTYPE=DRIVER
DRIVERTYPE=WDM

# Use KMDF (Windows Driver Framework)
KMDF_VERSION_MAJOR=1
KMDF_VERSION_MINOR=15

# Include paths
INCLUDES=$(INCLUDES);$(DDK_INC_PATH)

# Source files
SOURCES=InterruptLatencyMonitor.c

# Libraries
TARGETLIBS=$(DDK_LIB_PATH)\wdfldr.lib \
           $(DDK_LIB_PATH)\ntoskrnl.lib \
           $(DDK_LIB_PATH)\hal.lib

# Compiler flags
MSC_WARNING_LEVEL=/W4
C_DEFINES=$(C_DEFINES) -DUNICODE -D_UNICODE

# Target OS - Windows 10 and later (x64)
_NT_TARGET_VERSION=$(_NT_TARGET_VERSION_WIN10)

